# Browsing scales are deliberately denser than the old powers-of-four jumps.
# Small byte/field sizes get the most choices; larger scales keep a simple
# power-of-two / one-and-a-half-power rhythm.  :scale N remains unrestricted.
_FILE_SCALE_SMALL = (
