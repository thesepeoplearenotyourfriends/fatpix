ANSI_SGR_RE = re.compile(r"\x1b\[[0-9;]*m")

def visible_width(text: str) -> int:
    plain = ANSI_SGR_RE.sub("", text)
    return sum(2 if unicodedata.east_asian_width(ch) in ("W", "F") else 1 for ch in plain)

def fit_line(text: str, width: int) -> str:
    out: List[str] = []
    used = 0
    i = 0
    while i < len(text):
        if text[i] == "\x1b":
            match = ANSI_SGR_RE.match(text, i)
            if match:
                out.append(match.group(0))
                i = match.end()
                continue
        ch = text[i]
        cell_width = 2 if unicodedata.east_asian_width(ch) in ("W", "F") else 1
        if used + cell_width > width:
            break
        out.append(ch)
        used += cell_width
        i += 1
    return "".join(out)

def pad_line(text: str, width: int) -> str:
    clipped = fit_line(text, width)
    if "\x1b[" in clipped:
        clipped += "\x1b[0;97;40m"
    return clipped + " " * max(0, width - visible_width(clipped))

