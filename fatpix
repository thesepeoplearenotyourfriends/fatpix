class ByteSource:
    """Seekable byte source for regular files/block devices, or buffered stdin."""

    BLKGETSIZE64 = 0x80081272

    def __init__(self, path: Optional[str] = None, data: Optional[bytes] = None) -> None:
        if (path is None) == (data is None):
            raise ValueError("ByteSource needs exactly one of path or data")
        self.path = path
        self._data = data
        self.fd: Optional[int] = None
        if data is not None:
            self.size = len(data)
            return

        assert path is not None
        self.fd = os.open(path, os.O_RDONLY)
        st = os.fstat(self.fd)
        self.size = st.st_size
        if self.size <= 0:
            try:
                self.size = os.lseek(self.fd, 0, os.SEEK_END)
                os.lseek(self.fd, 0, os.SEEK_SET)
            except OSError:
                self.size = 0
        if self.size <= 0 and stat.S_ISBLK(st.st_mode):
            try:
                import fcntl
                buf = bytearray(8)
                fcntl.ioctl(self.fd, self.BLKGETSIZE64, buf, True)
                self.size = struct.unpack("=Q", buf)[0]
            except (ImportError, OSError, struct.error):
                self.size = 0
        if self.size <= 0 and not stat.S_ISREG(st.st_mode):
            self.close()
            raise OSError(f"could not determine size of {path!r}")

    def close(self) -> None:
        if self.fd is not None:
            os.close(self.fd)
            self.fd = None

    def read(self, offset: int, length: int) -> bytes:
        if length <= 0 or offset < 0 or offset >= self.size:
            return b""
        length = min(length, self.size - offset)
        if self._data is not None:
            return self._data[offset: offset + length]
        assert self.fd is not None
        if hasattr(os, "pread"):
            return os.pread(self.fd, length, offset)
        os.lseek(self.fd, offset, os.SEEK_SET)
        return os.read(self.fd, length)

    def sample(self, offset: int, length: int, budget: int = 1024) -> bytes:
        """Read one bounded representative window from a range.

        One contiguous read is intentionally preferred over many tiny random reads:
        coarse whole-device views care more about responsiveness than pretending a
        1 KiB sample is an exhaustive description of a 256 MiB cell.
        """
        if length <= budget:
            return self.read(offset, length)
        rel = (length - budget) // 2
        return self.read(offset + rel, budget)


def parse_offset(text: str) -> int:
    text = text.strip().lower()
    multipliers = {"k": 1024, "m": 1024**2, "g": 1024**3, "t": 1024**4}
    if text and text[-1] in multipliers:
        return int(text[:-1], 0) * multipliers[text[-1]]
    return int(text, 0)


def parse_scale(text: str) -> int:
    """Parse an integer byte count or a fractional binary-unit scale target."""
    value = text.strip().lower()
    match = re.fullmatch(r"([0-9]+(?:\.[0-9]+)?)([kmgt])b?", value)
    if match is None:
        return int(value, 0)
    number, suffix = match.groups()
    scaled = float(number) * {"k": 1024, "m": 1024**2, "g": 1024**3, "t": 1024**4}[suffix]
    if not math.isfinite(scaled) or not scaled.is_integer():
        raise ValueError("scale target must resolve to a whole number of bytes")
    return int(scaled)


def human_size(value: int) -> str:
    n = float(value)
    for unit in ("B", "KiB", "MiB", "GiB", "TiB"):
        if n < 1024.0 or unit == "TiB":
            return f"{int(n)} {unit}" if unit == "B" else f"{n:.1f} {unit}"
        n /= 1024.0
    return f"{value} B"


def shannon_entropy(data: bytes) -> float:
    if not data:
        return 0.0
    counts = Counter(data)
    total = len(data)
    return -sum((count / total) * math.log2(count / total) for count in counts.values())


