# Structural colors are a FatPix lens, not an overlay.  Repeated field types get
# the vivid six first (the natural red→orange→yellow→green→blue→purple legend);
# singleton fields then get brown/white.  Black remains available to the normal
# byte lens around recognized structure.
CLARITY_SEMANTIC_PALETTE = (2, 4, 5, 6, 3, 7, 8, 1)


def _build_file_scale_ladder() -> Tuple[int, ...]:
    steps = list(_FILE_SCALE_SMALL)
    power = 1024
    while power <= _FILE_SCALE_MAX:
        steps.append(power)
        one_and_half = power + power // 2
        if one_and_half <= _FILE_SCALE_MAX:
            steps.append(one_and_half)
        power <<= 1
    return tuple(sorted(set(steps)))


